<?xml version="1.0"?>
<JWM>
    <!-- PINGUINO - JWM THEME -->

<!-- WALLPAPER -->
    <Desktops> <Background type="gradient">#727272:#929292</Background><!-- JWManager custom background: <Background type="gradient">#39c3a9:#2166be</Background> --> </Desktops>
    
<!-- STARTUP APPS -->
    <StartupCommand>xset s off -dpms s noblank</StartupCommand>
    <StartupCommand>numlockx on</StartupCommand>
    <StartupCommand>lxqt-policykit-agent &amp;</StartupCommand>
    
<!-- RESIZE,MOVE & FOCUS MODE -->
    <MoveMode>outline</MoveMode>
    <ResizeMode>outline</ResizeMode>
    <SnapMode distance="10">border</SnapMode>
  	<FocusModel>click</FocusModel>
  	<DoubleClickSpeed>400</DoubleClickSpeed>
  	<DoubleClickDelta>2</DoubleClickDelta>

<!-- MENU -->
    <RootMenu onroot="12" height="22">
        <Include>.jwm/jwm-menu</Include>
    </RootMenu>
    
<!-- MENU STYLE -->
    <MenuStyle decorations="min">
        <Font>JetBrainsMono NL Nerd Font-10</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#000000</Background>
        <Outline>#000000</Outline>
        <Active>
            <Foreground>#000000</Foreground>
            <Background>#ffffff</Background>
        </Active>   
        <!-- Opzionale: aggiunge un bordo per separare visivamente il menu -->
        <Opacity>1.0</Opacity>
    </MenuStyle>

<!--APP PANEL -->
    <Tray x="0"y="-1"height="27">
        <TrayButton label="">root:1</TrayButton>
        <TrayButton label="" popup="Show Desktop">showdesktop</TrayButton>
        <Spacer width="1"/>
        <Pager labeled="true"/>
        <Spacer width="1"/>
        <TaskList maxwidth="200" list="current"/>
        <TrayButton label="  " popup="File Manager">exec:xterm -e yazi</TrayButton>
        <Spacer width="5"/>
        <TrayButton label="  " popup="Terminal Emulator">exec:xterm</TrayButton>  
        <Spacer width="5"/>
		<TrayButton label=" 󰖈 " popup="Wi-Fi">exec:xterm -e nmtui</TrayButton>      
		<Spacer width="5"/>
		<Dock/>
		 <!-- WATCH -->
		<Clock format="%H:%M"/>
		<Spacer width="4"/>
    	</Tray>
    	<ClockStyle>
			<Font>JetBrainsMonoNerdFontPropo:pixelsize=14:antialias=true:autohint=true</Font>
    	    <Foreground>#ffffff</Foreground>
    	    <Background>#000000</Background>
    	</ClockStyle>
    	
<!-- PANEL STYLE -->
    <TrayStyle decorations="min">
		<Font>JetBrainsMonoNerdFontMono:pixelsize=23:antialias=true:autohint=true</Font>
        <Background>#000000</Background>
        <Outline>#000000</Outline>
        <Active>
            <Background>#ffffff</Background> <!-- pulsante start pannello-->
            <Foreground>#000000</Foreground>
        </Active>
    </TrayStyle>
    
 <!-- BUTTON PANEL SYLE -->
        <TaskListStyle group="false" decorations="min">
            <Font>JetBrainsMono NL Nerd Font-10</Font>
            <Background>#000000</Background>
            <Foreground>#7d7d7d</Foreground>     
            <Active>
                <Background>#000000</Background>
                <Foreground>#ffffff</Foreground>
            </Active>
        </TaskListStyle>

<!-- MULTIPLE DESKTOP  -->
    <Desktops width="2" height="1">
        <Desktop name="1"/>
        <Desktop name="2"/>
    </Desktops>

    <PagerStyle>
        <Font>JetBrainsMono NL Nerd Font-10</Font>
        <Foreground>#1d1d1d</Foreground> <!-- miniatura finestra desktop inattivo -->
        <Background>#000000</Background> <!-- desktop inattivi -->
        <Outline>#000000</Outline> <!-- divisore -->
        <Text>#ffffff</Text>
        <Active>
            <Foreground>#000000</Foreground> <!-- miniatura finestra desktop attivo -->
            <Background>#1d1d1d</Background> <!-- colore desktop attivo -->
        </Active>
    </PagerStyle>


<!-- WINDOW STYLE -->
    <WindowStyle decorations="min">
        <Font>JetBrainsMono NL Nerd Font-10</Font>
        <Width>1</Width>
        <Height>25</Height>
        <Corner>0</Corner>
        <Foreground>#7d7d7d</Foreground>
        <Background>#000000</Background>
        <Outline>#000000</Outline>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#000000</Background> <!-- finesta attiva -->
            <Outline>#000000</Outline>
        </Active>
    </WindowStyle>

<!-- SHOTCUT MENU-->
    <Key key="Super_L">root:1</Key>
    <Key mask="C" key="t">exec:xterm</Key>
    <Key mask="A" key="x">exec:xfe</Key>

<!-- ICONS -->
    <FocusModel>click</FocusModel>
    <IconPath>/home/wario/.jwm/icons</IconPath>

</JWM>
