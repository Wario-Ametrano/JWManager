<?xml version="1.0"?>
<JWM>

    <!-- JWM DEFAULT THEME -->

    <!-- ========================= -->
    <!--            StartupCommand           -->
    <!-- ========================= -->
    <StartupCommand>xset s off -dpms s noblank</StartupCommand>
    <StartupCommand>numlockx on</StartupCommand>
    <StartupCommand>lxqt-policykit-agent &amp;</StartupCommand>

    <StartupCommand>xset s off</StartupCommand>
    <StartupCommand>xset -dpms</StartupCommand>
    <StartupCommand>xset s noblank</StartupCommand>

<!-- WALLPAPER -->
    <Desktops> <Background type="gradient">#041b39:#387cb0</Background> </Desktops>

       <!-- ========================= -->
    <!--            MENU           -->
    <!-- ========================= -->

 <MenuStyle decorations="motif">
        <Font>Sans-12</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#333333</Background>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0077CC</Background>
        </Active>
        <Opacity>0.85</Opacity>
    </MenuStyle>

    <RootMenu onroot="12">
        <Include>.jwm/jwm_menu</Include>
    </RootMenu>

   <!-- ========================= -->
    <!--         WINDOW STYLE      -->
    <!-- ========================= -->

    <WindowStyle decorations="motif">
        <Font>Sans-12:bold</Font>
        <Width>2</Width>
        <Height>22</Height>
        <Corner>0</Corner>
        <Foreground>#FFFFFF</Foreground>
        <Background>#555555</Background>
        <Opacity>0.5</Opacity>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0077CC</Background>
            <Opacity>1.0</Opacity>
        </Active>
    </WindowStyle>

    <!-- ========================= -->
    <!--        BUTTON STYLE       -->
    <!-- ========================= -->

    <ButtonStyle decorations="motif">
        <Font>Sans-10</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#333333</Background>
        <Active>
            <Background>#333333</Background>
        </Active>
    </ButtonStyle>

 <!-- ========================= -->
    <!--         TRAY STYLE        -->
    <!-- ========================= -->

    <TrayStyle decorations="motif">
        <Font>Sans-12</Font>
        <Background>#333333</Background>
        <Foreground>#FFFFFF</Foreground>
        <Opacity>1.00</Opacity>
    </TrayStyle>

<!-- ========================= -->
    <!--            TRAY           -->
    <!-- ========================= -->

    <Tray x="0" y="-1" height="25" autohide="off" delay="1000">
        <TrayButton icon="/usr/share/jwm/jwm-red.svg">root:1</TrayButton>
        <Spacer width="2"/>
        <TrayButton label="_">showdesktop</TrayButton>
        <Spacer width="2"/>
        <Pager labeled="true"/>
        <TaskList maxwidth="258"/>
        <TrayButton icon="terminal">exec:xterm</TrayButton>
        <TrayButton icon="folder">exec:xfe</TrayButton>
        <Dock />
        <Clock format="%a %H:%M">xclock</Clock>
    </Tray>

    <!-- ========================= -->
    <!--       TASKLIST STYLE      -->
    <!-- ========================= -->

    <TaskListStyle group="false">
      <Font>Sans-12</Font>
      <Active>
        <Foreground>#FFFFFF</Foreground>
        <Background>#555555</Background>
      </Active>
      <Minimized>
        <Foreground>#FFFFFF</Foreground>
        <Background>#333333</Background>
      </Minimized>
      <Foreground>#FFFFFF</Foreground> 
      <Background>#333333</Background>
    </TaskListStyle>

<!-- ========================= -->
    <!--        PAGER STYLE        -->
    <!-- ========================= -->

    <PagerStyle decorations="motif">
        <Foreground>#555555</Foreground>
        <Background>#333333</Background>
        <Text>#FFFFFF</Text>
        <Active>
            <Foreground>#0077CC</Foreground>
            <Background>#004488</Background>
        </Active>
    </PagerStyle>
   
    <PopupStyle>
        <Font>Sans-12</Font>
        <Foreground>#000000</Foreground>
        <Background>#999999</Background>
    </PopupStyle>

    <!-- ========================= -->
    <!--         DESKTOPS          -->
    <!-- ========================= -->

    <!-- Virtual Desktops -->
    <!-- Desktop tags can be contained within Desktops for desktop names. -->
    <Desktops width="3" height="1"></Desktops>

    <!-- Double click speed (in milliseconds) -->
    <DoubleClickSpeed>400</DoubleClickSpeed>

    <!-- Double click delta (in pixels) -->
    <DoubleClickDelta>2</DoubleClickDelta>

    <!-- The focus model (sloppy or click) -->
    <FocusModel>click</FocusModel>

    <!-- The snap mode (none, screen, or border) -->
    <SnapMode distance="10">border</SnapMode>

    <!-- The move mode (outline or opaque) -->
    <MoveMode>outline</MoveMode>

    <!-- The resize mode (outline or opaque) -->
    <ResizeMode>outline</ResizeMode>

    <!-- ========================= -->
    <!--         ICON PATHS        -->
    <!-- ========================= -->

    <IconPath>.jwm/icons/Default</IconPath>



    <!-- SHOTCUT MENU-->
    <Key key="Super_L">root:1</Key>
    <Key mask="C" key="t">exec:xterm</Key>
    <Key mask="A" key="x">exec:xfe</Key>

</JWM>
